{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "flyingsalmon",
  "homepage": "https://flyingsalmon.superbrian.dev",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "flyingsalmon theme",
      "description": "Soft, minimal, playful. Baloo 2 headings, Onest body, indigo accent over pure neutral grays, 12px radius, light and dark.",
      "dependencies": [
        "@fontsource-variable/baloo-2",
        "@fontsource-variable/onest"
      ],
      "css": {
        "@import \"@fontsource-variable/baloo-2\"": {},
        "@import \"@fontsource-variable/onest\"": {}
      },
      "cssVars": {
        "theme": {
          "font-sans": "'Onest Variable', sans-serif",
          "font-heading": "'Baloo 2 Variable', var(--font-sans)",
          "motion-fast": "100ms",
          "motion-base": "150ms"
        },
        "light": {
          "background": "var(--color-white)",
          "foreground": "var(--color-neutral-950)",
          "card": "var(--color-white)",
          "card-foreground": "var(--color-neutral-950)",
          "popover": "var(--color-white)",
          "popover-foreground": "var(--color-neutral-950)",
          "primary": "var(--color-indigo-600)",
          "primary-foreground": "var(--color-neutral-50)",
          "secondary": "var(--color-neutral-100)",
          "secondary-foreground": "var(--color-neutral-900)",
          "muted": "var(--color-neutral-100)",
          "muted-foreground": "var(--color-neutral-500)",
          "skeleton": "var(--color-neutral-300)",
          "accent": "var(--color-indigo-50)",
          "accent-foreground": "var(--color-indigo-700)",
          "destructive": "var(--color-red-600)",
          "success": "var(--color-green-100)",
          "success-foreground": "var(--color-green-800)",
          "warning": "var(--color-amber-100)",
          "warning-foreground": "var(--color-amber-800)",
          "error": "var(--color-red-100)",
          "error-foreground": "var(--color-red-700)",
          "border": "var(--color-neutral-200)",
          "input": "var(--color-neutral-200)",
          "ring": "var(--color-indigo-500)",
          "chart-1": "var(--color-indigo-300)",
          "chart-2": "var(--color-indigo-400)",
          "chart-3": "var(--color-indigo-500)",
          "chart-4": "var(--color-indigo-600)",
          "chart-5": "var(--color-indigo-700)",
          "radius": "0.75rem",
          "sidebar": "var(--color-neutral-50)",
          "sidebar-foreground": "var(--color-neutral-950)",
          "sidebar-primary": "var(--color-indigo-600)",
          "sidebar-primary-foreground": "var(--color-neutral-50)",
          "sidebar-accent": "var(--color-neutral-100)",
          "sidebar-accent-foreground": "var(--color-neutral-900)",
          "sidebar-border": "var(--color-neutral-200)",
          "sidebar-ring": "var(--color-indigo-500)"
        },
        "dark": {
          "background": "var(--color-neutral-950)",
          "foreground": "var(--color-neutral-50)",
          "card": "var(--color-neutral-900)",
          "card-foreground": "var(--color-neutral-50)",
          "popover": "var(--color-neutral-900)",
          "popover-foreground": "var(--color-neutral-50)",
          "primary": "var(--color-indigo-400)",
          "primary-foreground": "var(--color-neutral-950)",
          "secondary": "var(--color-neutral-800)",
          "secondary-foreground": "var(--color-neutral-50)",
          "muted": "var(--color-neutral-800)",
          "muted-foreground": "var(--color-neutral-400)",
          "skeleton": "var(--color-neutral-800)",
          "accent": "var(--color-indigo-950)",
          "accent-foreground": "var(--color-neutral-50)",
          "destructive": "var(--color-red-400)",
          "success": "var(--color-green-950)",
          "success-foreground": "var(--color-green-300)",
          "warning": "var(--color-amber-950)",
          "warning-foreground": "var(--color-amber-300)",
          "error": "var(--color-red-950)",
          "error-foreground": "var(--color-red-300)",
          "border": "var(--color-neutral-800)",
          "input": "var(--color-neutral-700)",
          "ring": "var(--color-indigo-500)",
          "chart-1": "var(--color-indigo-300)",
          "chart-2": "var(--color-indigo-400)",
          "chart-3": "var(--color-indigo-500)",
          "chart-4": "var(--color-indigo-600)",
          "chart-5": "var(--color-indigo-700)",
          "sidebar": "var(--color-neutral-900)",
          "sidebar-foreground": "var(--color-neutral-50)",
          "sidebar-primary": "var(--color-indigo-500)",
          "sidebar-primary-foreground": "var(--color-neutral-50)",
          "sidebar-accent": "var(--color-neutral-800)",
          "sidebar-accent-foreground": "var(--color-neutral-50)",
          "sidebar-border": "var(--color-neutral-800)",
          "sidebar-ring": "var(--color-indigo-500)"
        }
      }
    },
    {
      "name": "motion",
      "type": "registry:lib",
      "title": "Motion tokens",
      "description": "The motion language: duration constants and the spring-bounce / spring-settle presets every component animates with.",
      "dependencies": ["motion"],
      "files": [
        { "path": "src/registry/lib/motion.ts", "type": "registry:lib" }
      ]
    },
    {
      "name": "field",
      "type": "registry:lib",
      "title": "Field primitives",
      "description": "The wiring every field component shares: the label-to-control id linkage with its aria-describedby merge, and the animated error message.",
      "registryDependencies": ["@flyingsalmon/motion"],
      "files": [
        { "path": "src/registry/lib/field.tsx", "type": "registry:lib" }
      ]
    },
    {
      "name": "spinner",
      "type": "registry:ui",
      "title": "Spinner",
      "description": "The loading primitive for action busyness. One variant, two sizes, a currentColor arc rotating once per 800ms.",
      "dependencies": ["class-variance-authority", "lucide-react"],
      "files": [
        { "path": "src/registry/ui/spinner.tsx", "type": "registry:ui" }
      ],
      "cssVars": {
        "theme": {
          "animate-spinner": "spinner-rotate 800ms linear infinite"
        }
      },
      "css": {
        "@keyframes spinner-rotate": {
          "to": { "transform": "rotate(360deg)" }
        }
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "The action component. Five variants, four sizes, and a loading state that morphs the button around its own spinner while it stays focused and reachable.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["@flyingsalmon/motion", "@flyingsalmon/spinner"],
      "files": [{ "path": "src/registry/ui/button.tsx", "type": "registry:ui" }]
    },
    {
      "name": "alert",
      "type": "registry:ui",
      "title": "Alert",
      "description": "The app's inline vehicle for the result of an action. A neutral surface where the icon carries the variant, two sizes, an optional close button, and its own enter and exit animation.",
      "dependencies": ["class-variance-authority", "lucide-react"],
      "registryDependencies": ["@flyingsalmon/motion", "@flyingsalmon/button"],
      "files": [{ "path": "src/registry/ui/alert.tsx", "type": "registry:ui" }]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "A single-line text field that owns its label, error message, and busyness. Text-like types only; stays editable while loading.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["@flyingsalmon/field", "@flyingsalmon/spinner"],
      "files": [{ "path": "src/registry/ui/input.tsx", "type": "registry:ui" }]
    },
    {
      "name": "textarea",
      "type": "registry:ui",
      "title": "Textarea",
      "description": "A multiline text field that owns its label, error message, and busyness. Autosizes between a row floor and a row cap; stays editable while loading.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["@flyingsalmon/field", "@flyingsalmon/spinner"],
      "files": [
        { "path": "src/registry/ui/textarea.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "switch",
      "type": "registry:ui",
      "title": "Switch",
      "description": "An instant-apply on/off control that owns its label and its own busyness. One size, no variants, no error state; a failed toggle is a result the app shows.",
      "dependencies": ["class-variance-authority", "radix-ui"],
      "registryDependencies": ["@flyingsalmon/motion"],
      "files": [
        { "path": "src/registry/ui/switch.tsx", "type": "registry:ui" }
      ],
      "cssVars": {
        "theme": {
          "animate-switch-thumb-pulse": "switch-thumb-pulse 800ms ease-in-out infinite"
        }
      },
      "css": {
        "@keyframes switch-thumb-pulse": {
          "50%": { "opacity": "0.7" }
        }
      }
    },
    {
      "name": "checkbox",
      "type": "registry:ui",
      "title": "Checkbox",
      "description": "A tri-state checkbox that owns its label and error message. One 20px size; the check mark morphs into a dash for the indeterminate state.",
      "dependencies": ["class-variance-authority", "radix-ui"],
      "registryDependencies": ["@flyingsalmon/field", "@flyingsalmon/motion"],
      "files": [
        { "path": "src/registry/ui/checkbox.tsx", "type": "registry:ui" }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "A static marker for a status, a category, or a small count. Six variants, one size, never focusable and never animated.",
      "dependencies": ["class-variance-authority"],
      "files": [{ "path": "src/registry/ui/badge.tsx", "type": "registry:ui" }]
    },
    {
      "name": "avatar",
      "type": "registry:ui",
      "title": "Avatar",
      "description": "The identity mark for a person. Image, then two initials on one of eight step-400 hues, then a plain circle. Static and non-focusable.",
      "dependencies": ["class-variance-authority"],
      "files": [{ "path": "src/registry/ui/avatar.tsx", "type": "registry:ui" }]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "A flat container that groups related content on one surface. Seven slots, one padding step, no variants; `interactive` opts into hover, press, and focus feedback through a stretched title link.",
      "dependencies": ["class-variance-authority"],
      "files": [{ "path": "src/registry/ui/card.tsx", "type": "registry:ui" }],
      "cssVars": {
        "theme": {
          "card-spacing": "--spacing(4)"
        }
      }
    },
    {
      "name": "skeleton",
      "type": "registry:ui",
      "title": "Skeleton",
      "description": "The region-loading placeholder. Three shape presets sized by the consumer, pulsing on a 2s cycle, always hidden from assistive technology.",
      "dependencies": ["class-variance-authority"],
      "files": [
        { "path": "src/registry/ui/skeleton.tsx", "type": "registry:ui" }
      ],
      "cssVars": {
        "theme": {
          "animate-skeleton-pulse": "skeleton-pulse 2s ease-in-out infinite"
        }
      },
      "css": {
        "@keyframes skeleton-pulse": {
          "0%, 100%": { "opacity": "1" },
          "50%": { "opacity": "0.5" }
        }
      }
    }
  ]
}
